Project python_fastapi_backend {

  database_type: 'PostgreSQL'

  Note: '''
    Production-ready FastAPI + SQLAlchemy + Alembic database foundation.

    Architecture:

    - Users are global identities.
    - Organizations represent tenant/workspace/company boundaries.
    - Users join organizations through organization_memberships.
    - Roles belong to organizations.
    - Permissions are a global platform catalog.
    - Roles receive permissions through role_permissions.
    - Organization memberships receive roles through membership_roles.
    - Authentication sessions belong to users globally, not organizations.
    - Audit logs may represent either organization-scoped or global events.

    Core security rule:

      Identity != Membership != Authorization

    A user may belong to multiple organizations with different roles
    and permissions in each organization.

    PostgreSQL-specific CHECK constraints, partial indexes, triggers,
    exclusion rules, and optional RLS policies should be implemented
    using Alembic migrations where DBML cannot express them precisely.
    Row-level security (RLS) is noted here as a future option; it is not
    implemented in the current application code or migrations.
  '''
}


/* ================================================================
   ORGANIZATIONS / TENANCY
   ================================================================ */

Table organizations {

  id uuid [
    pk,
    not null,
    default: `gen_random_uuid()`,
    note: 'Globally unique organization identifier.'
  ]

  code varchar(80) [
    not null,
    note: 'Normalized globally unique organization/workspace code.'
  ]

  name varchar(200) [
    not null,
    note: 'Organization display name.'
  ]

  status varchar(50) [
    not null,
    default: 'active',
    note: 'Allowed values: active, suspended, inactive, pending_deletion, deleted.'
  ]

  suspended_at timestamptz

  deleted_at timestamptz

  created_at timestamptz [
    not null,
    default: `now()`
  ]

  updated_at timestamptz [
    not null,
    default: `now()`
  ]

  indexes {

    code [
      unique,
      name: 'organizations_code_key'
    ]

    status [
      name: 'organizations_status_idx'
    ]

    deleted_at [
      name: 'organizations_deleted_at_idx'
    ]

  }

  Note: '''
    Tenant/workspace/company boundary for organization-owned resources.

    Recommended PostgreSQL constraints:

    CHECK (char_length(trim(code)) > 0)

    CHECK (char_length(trim(name)) > 0)

    CHECK (
      status IN (
        'active',
        'suspended',
        'inactive',
        'pending_deletion',
        'deleted'
      )
    )
  '''
}


/* ================================================================
   GLOBAL USER IDENTITIES
   ================================================================ */

Table users {

  id uuid [
    pk,
    not null,
    default: `gen_random_uuid()`,
    note: 'Globally unique user identity.'
  ]

  name varchar(200) [
    not null,
    note: 'User display name.'
  ]

  email varchar(255) [
    note: 'Original/display email address.'
  ]

  phone varchar(50) [
    note: 'Original/display phone number.'
  ]

  password_hash varchar(500) [
    not null,
    note: 'One-way password hash. Never stores plaintext.'
  ]

  status varchar(50) [
    not null,
    default: 'active',
    note: 'Allowed values: active, inactive, locked, disabled, deleted.'
  ]

  email_verified_at timestamptz

  phone_verified_at timestamptz

  last_login_at timestamptz

  last_logout_at timestamptz

  password_changed_at timestamptz

  locked_at timestamptz

  deleted_at timestamptz

  created_at timestamptz [
    not null,
    default: `now()`
  ]

  updated_at timestamptz [
    not null,
    default: `now()`
  ]

  indexes {
    status [
      name: 'users_status_idx'
    ]

    created_at [
      name: 'users_created_at_idx'
    ]

    deleted_at [
      name: 'users_deleted_at_idx'
    ]
  }

  Note: '''
    Global authentication identity.

    A user is not owned by an organization and may join multiple organizations.

    Recommended PostgreSQL constraints:

    CHECK (char_length(trim(name)) > 0)

    CHECK (
      status IN (
        'active',
        'inactive',
        'locked',
        'disabled',
        'deleted'
      )
    )

    If soft-deleted identifiers should become reusable, replace the normal
    unique constraints with partial unique indexes where deleted_at IS NULL.

    The baseline migration enforces a partial unique index on lower(email)
    and a partial unique index on phone where deleted_at IS NULL. DBML cannot
    express these PostgreSQL expression/partial indexes precisely.
  '''
}


/* ================================================================
   ORGANIZATION MEMBERSHIP
   ================================================================ */

Table organization_memberships {

  id uuid [
    pk,
    not null,
    default: `gen_random_uuid()`,
    note: 'Membership identity representing one user inside one organization.'
  ]

  organization_id uuid [
    not null
  ]

  user_id uuid [
    not null
  ]

  status varchar(50) [
    not null,
    default: 'active',
    note: 'Allowed values: invited, active, suspended, inactive, removed.'
  ]

  invited_by_membership_id uuid [
    note: 'Existing organization membership that issued the invitation.'
  ]

  invited_at timestamptz

  joined_at timestamptz [
    note: 'When the user first joined/accepted membership.'
  ]

  activated_at timestamptz

  suspended_at timestamptz

  removed_at timestamptz

  created_at timestamptz [
    not null,
    default: `now()`
  ]

  updated_at timestamptz [
    not null,
    default: `now()`
  ]

  indexes {

    (organization_id, id) [
      unique,
      name: 'organization_memberships_org_id_id_key'
    ]

    (organization_id, user_id) [
      unique,
      name: 'organization_memberships_org_user_key'
    ]

    (organization_id, status) [
      name: 'organization_memberships_org_status_idx'
    ]

    user_id [
      name: 'organization_memberships_user_id_idx'
    ]

  }

  Note: '''
    Connects a global user identity to an organization.

    This table defines organization participation independently from
    global user account status.

    Example:

      User = active globally
      Organization A membership = active
      Organization B membership = suspended
      Organization C membership = removed

    Recommended CHECK:

    CHECK (
      status IN (
        'invited',
        'active',
        'suspended',
        'inactive',
        'removed'
      )
    )
  '''
}


/* ================================================================
   GLOBAL PERMISSION CATALOG
   ================================================================ */

Table permissions {

  id uuid [
    pk,
    not null,
    default: `gen_random_uuid()`
  ]

  code varchar(120) [
    not null,
    note: 'Globally unique permission code such as users.read.'
  ]

  name varchar(160) [
    not null
  ]

  module varchar(80) [
    not null,
    note: 'Feature module/group.'
  ]

  description text

  is_active boolean [
    not null,
    default: true
  ]

  created_at timestamptz [
    not null,
    default: `now()`
  ]

  updated_at timestamptz [
    not null,
    default: `now()`
  ]

  indexes {

    code [
      unique,
      name: 'permissions_code_key'
    ]

    module [
      name: 'permissions_module_idx'
    ]

    (module, is_active) [
      name: 'permissions_module_is_active_idx'
    ]

  }

  Note: '''
    Global platform capability catalog.

    Recommended permission convention:

      <resource>.<action>

    Examples:

      organization_members.read
      organization_members.invite
      organization_members.remove

      users.read

      roles.read
      roles.create
      roles.update
      roles.delete

      events.read
      events.create
      events.update
      events.delete

      audit_logs.read
  '''
}


/* ================================================================
   ORGANIZATION-SCOPED ROLES
   ================================================================ */

Table roles {

  id uuid [
    pk,
    not null,
    default: `gen_random_uuid()`
  ]

  organization_id uuid [
    not null,
    note: 'Organization owning this role.'
  ]

  code varchar(80) [
    not null,
    note: 'Stable machine-readable role code unique inside the organization.'
  ]

  name varchar(120) [
    not null
  ]

  description text

  is_system boolean [
    not null,
    default: false,
    note: 'Protected organization role created from platform defaults.'
  ]

  is_active boolean [
    not null,
    default: true
  ]

  created_at timestamptz [
    not null,
    default: `now()`
  ]

  updated_at timestamptz [
    not null,
    default: `now()`
  ]

  indexes {

    (organization_id, id) [
      unique,
      name: 'roles_org_id_id_key'
    ]

    (organization_id, code) [
      unique,
      name: 'roles_org_code_key'
    ]

    (organization_id, is_active) [
      name: 'roles_org_is_active_idx'
    ]

  }

  Note: '''
    Organization-scoped permission bundle.

    Organizations may define custom roles independently.
  '''
}


Table role_permissions {

  id uuid [
    pk,
    not null,
    default: `gen_random_uuid()`
  ]

  organization_id uuid [
    not null
  ]

  role_id uuid [
    not null
  ]

  permission_id uuid [
    not null
  ]

  granted_by_membership_id uuid [
    note: 'Organization membership responsible for granting this permission.'
  ]

  granted_at timestamptz [
    not null,
    default: `now()`
  ]

  indexes {

    (organization_id, role_id, permission_id) [
      unique,
      name: 'role_permissions_org_role_permission_key'
    ]

    (organization_id, role_id) [
      name: 'role_permissions_org_role_idx'
    ]

    (organization_id, permission_id) [
      name: 'role_permissions_org_permission_idx'
    ]

  }

  Note: '''
    Connects an organization-owned role to a global platform permission.
  '''
}


/* ================================================================
   MEMBERSHIP ROLE ASSIGNMENT
   ================================================================ */

Table membership_roles {

  id uuid [
    pk,
    not null,
    default: `gen_random_uuid()`
  ]

  organization_id uuid [
    not null
  ]

  membership_id uuid [
    not null,
    note: 'Organization membership receiving the role.'
  ]

  role_id uuid [
    not null,
    note: 'Organization role assigned to the membership.'
  ]

  assigned_by_membership_id uuid [
    note: 'Organization membership that made the assignment.'
  ]

  assigned_at timestamptz [
    not null,
    default: `now()`
  ]

  expires_at timestamptz [
    note: 'Optional expiration for temporary assignments.'
  ]

  indexes {

    (organization_id, membership_id, role_id) [
      unique,
      name: 'membership_roles_org_membership_role_key'
    ]

    (organization_id, membership_id) [
      name: 'membership_roles_org_membership_idx'
    ]

    (organization_id, role_id) [
      name: 'membership_roles_org_role_idx'
    ]

    (organization_id, expires_at) [
      name: 'membership_roles_org_expires_at_idx'
    ]

  }

  Note: '''
    Assigns organization roles to organization memberships.

    Roles are intentionally not assigned directly to global users.

    Recommended CHECK:

    CHECK (
      expires_at IS NULL
      OR expires_at > assigned_at
    )
  '''
}


/* ================================================================
   GLOBAL USER AUTHENTICATION SESSIONS
   ================================================================ */

Table user_sessions {

  id uuid [
    pk,
    not null,
    default: `gen_random_uuid()`
  ]

  user_id uuid [
    not null,
    note: 'Global user owning this login/device session.'
  ]

  session_key_hash varchar(500) [
    note: 'Optional hashed opaque session identifier.'
  ]

  device_name varchar(200)

  user_agent text

  ip_address inet

  last_seen_at timestamptz

  expires_at timestamptz [
    not null
  ]

  revoked_at timestamptz

  revoke_reason varchar(200)

  created_at timestamptz [
    not null,
    default: `now()`
  ]

  updated_at timestamptz [
    not null,
    default: `now()`
  ]

  indexes {

    user_id [
      name: 'user_sessions_user_id_idx'
    ]

    (user_id, revoked_at) [
      name: 'user_sessions_user_revoked_at_idx'
    ]

    expires_at [
      name: 'user_sessions_expires_at_idx'
    ]

  }

  Note: '''
    Global authenticated user/device session.

    Sessions do not belong to one organization because the same session
    may access multiple organizations through organization memberships.

    Recommended constraints:

    CHECK (expires_at > created_at)

    CHECK (
      revoked_at IS NULL
      OR revoked_at >= created_at
    )
  '''
}


Table user_refresh_tokens {

  id uuid [
    pk,
    not null,
    default: `gen_random_uuid()`
  ]

  user_id uuid [
    not null
  ]

  session_id uuid [
    not null
  ]

  token_hash varchar(500) [
    not null,
    note: 'Cryptographic hash of an opaque refresh token.'
  ]

  parent_token_id uuid [
    note: 'Previous token in this rotation chain.'
  ]

  replaced_by_token_id uuid [
    note: 'Next refresh token issued after rotation.'
  ]

  used_at timestamptz

  expires_at timestamptz [
    not null
  ]

  revoked_at timestamptz

  revoke_reason varchar(200)

  created_at timestamptz [
    not null,
    default: `now()`
  ]

  indexes {

    token_hash [
      unique,
      name: 'user_refresh_tokens_token_hash_key'
    ]

    session_id [
      name: 'user_refresh_tokens_session_id_idx'
    ]

    user_id [
      name: 'user_refresh_tokens_user_id_idx'
    ]

    (session_id, revoked_at) [
      name: 'user_refresh_tokens_session_revoked_at_idx'
    ]

    expires_at [
      name: 'user_refresh_tokens_expires_at_idx'
    ]

    parent_token_id [
      name: 'user_refresh_tokens_parent_token_id_idx'
    ]

  }

  Note: '''
    Rotating opaque refresh credential.

    Refresh token reuse detection should revoke the associated session/token
    family.

    Recommended CHECK constraints:

    CHECK (expires_at > created_at)

    CHECK (
      used_at IS NULL
      OR used_at >= created_at
    )

    CHECK (
      revoked_at IS NULL
      OR revoked_at >= created_at
    )
  '''
}


/* ================================================================
   ACCOUNT VERIFICATION / PASSWORD RESET
   ================================================================ */

Table user_email_verification_tokens {

  id uuid [
    pk,
    not null,
    default: `gen_random_uuid()`
  ]

  user_id uuid [
    not null
  ]

  email_normalized varchar(255) [
    not null
  ]

  token_hash varchar(500) [
    not null
  ]

  expires_at timestamptz [
    not null
  ]

  consumed_at timestamptz

  created_at timestamptz [
    not null,
    default: `now()`
  ]

  indexes {

    token_hash [
      unique,
      name: 'user_email_verification_tokens_token_hash_key'
    ]

    user_id [
      name: 'user_email_verification_tokens_user_id_idx'
    ]

    expires_at [
      name: 'user_email_verification_tokens_expires_at_idx'
    ]

  }

  Note: '''
    Global account email verification token.

    Organization context is intentionally absent.
  '''
}


Table user_password_reset_tokens {

  id uuid [
    pk,
    not null,
    default: `gen_random_uuid()`
  ]

  user_id uuid [
    not null
  ]

  token_hash varchar(500) [
    not null
  ]

  expires_at timestamptz [
    not null
  ]

  consumed_at timestamptz

  created_at timestamptz [
    not null,
    default: `now()`
  ]

  indexes {

    token_hash [
      unique,
      name: 'user_password_reset_tokens_token_hash_key'
    ]

    user_id [
      name: 'user_password_reset_tokens_user_id_idx'
    ]

    expires_at [
      name: 'user_password_reset_tokens_expires_at_idx'
    ]

  }

  Note: '''
    Global password reset token.

    Successful password reset should normally:
      - consume the token
      - update password_hash
      - update password_changed_at
      - revoke all active user sessions
  '''
}


/* ================================================================
   AUDIT LOGS
   ================================================================ */

Table audit_logs {

  id uuid [
    pk,
    not null,
    default: `gen_random_uuid()`
  ]

  organization_id uuid [
    note: '''
      Organization context of this event.

      NULL means platform/global event.
    '''
  ]

  actor_type varchar(50) [
    not null,
    default: 'user',
    note: 'Allowed values: user, system, service, api_key.'
  ]

  actor_user_id uuid [
    note: 'Global acting user when known.'
  ]

  actor_membership_id uuid [
    note: 'Organization membership used when action occurred in organization context.'
  ]

  actor_snapshot jsonb [
    note: 'Sanitized historical actor metadata.'
  ]

  action varchar(120) [
    not null,
    note: 'Stable machine-readable action code.'
  ]

  entity_type varchar(120) [
    not null
  ]

  entity_id uuid [
    note: 'Affected UUID entity when applicable.'
  ]

  before_json jsonb

  after_json jsonb

  metadata_json jsonb

  reason text

  request_id varchar(100)

  trace_id varchar(100)

  ip_address inet

  user_agent text

  created_at timestamptz [
    not null,
    default: `now()`
  ]

  indexes {

    (organization_id, entity_type, entity_id) [
      name: 'audit_logs_org_entity_idx'
    ]

    (organization_id, actor_membership_id, created_at) [
      name: 'audit_logs_org_membership_created_at_idx'
    ]

    (organization_id, actor_user_id, created_at) [
      name: 'audit_logs_org_user_created_at_idx'
    ]

    (organization_id, action, created_at) [
      name: 'audit_logs_org_action_created_at_idx'
    ]

    (organization_id, created_at) [
      name: 'audit_logs_org_created_at_idx'
    ]

    actor_user_id [
      name: 'audit_logs_actor_user_id_idx'
    ]

    request_id [
      name: 'audit_logs_request_id_idx'
    ]

    trace_id [
      name: 'audit_logs_trace_id_idx'
    ]

  }

  Note: '''
    Append-only audit trail.

    organization_id is nullable so the same table supports:

      Organization event:
        organization_id = <organization>

      Global identity/platform event:
        organization_id = NULL

    Recommended CHECK:

    CHECK (
      actor_type IN (
        'user',
        'system',
        'service',
        'api_key'
      )
    )

    Sensitive data such as passwords, hashes, tokens, authorization headers,
    API keys, and secrets must be redacted before storing JSON snapshots.

    Normal application roles should not receive UPDATE or DELETE privileges
    for this table.
  '''
}


/* ================================================================
   ORGANIZATION RELATIONSHIPS
   ================================================================ */

Ref: organizations.id < organization_memberships.organization_id [
  delete: restrict
]

Ref: organizations.id < roles.organization_id [
  delete: restrict
]

Ref: organizations.id < role_permissions.organization_id [
  delete: restrict
]

Ref: organizations.id < membership_roles.organization_id [
  delete: restrict
]

Ref: organizations.id < audit_logs.organization_id [
  delete: restrict
]


/* ================================================================
   GLOBAL USER RELATIONSHIPS
   ================================================================ */

Ref: users.id < organization_memberships.user_id [
  delete: restrict
]

Ref: users.id < user_sessions.user_id [
  delete: cascade
]

Ref: users.id < user_refresh_tokens.user_id [
  delete: cascade
]

Ref: users.id < user_email_verification_tokens.user_id [
  delete: cascade
]

Ref: users.id < user_password_reset_tokens.user_id [
  delete: cascade
]

Ref: users.id < audit_logs.actor_user_id [
  delete: set null
]


/* ================================================================
   MEMBERSHIP RELATIONSHIPS
   ================================================================ */

Ref: organization_memberships.(organization_id, id)
  < membership_roles.(organization_id, membership_id) [
  delete: cascade
]

Ref: organization_memberships.(organization_id, id)
  < membership_roles.(organization_id, assigned_by_membership_id) [
  delete: restrict
]

Ref: organization_memberships.(organization_id, id)
  < role_permissions.(organization_id, granted_by_membership_id) [
  delete: restrict
]

Ref: organization_memberships.id
  < organization_memberships.invited_by_membership_id [
  delete: set null
]

Ref: organization_memberships.id
  < audit_logs.actor_membership_id [
  delete: set null
]


/* ================================================================
   ROLE / PERMISSION RELATIONSHIPS
   ================================================================ */
Ref: roles.(organization_id, id)
  < role_permissions.(organization_id, role_id) [
  delete: cascade
]

Ref: permissions.id < role_permissions.permission_id [
  delete: restrict
]

Ref: roles.(organization_id, id)
  < membership_roles.(organization_id, role_id) [
  delete: cascade
]


/* ================================================================
   SESSION / REFRESH TOKEN RELATIONSHIPS
   ================================================================ */

Ref: user_sessions.id < user_refresh_tokens.session_id [
  delete: cascade
]

Ref: user_refresh_tokens.id < user_refresh_tokens.parent_token_id [
  delete: set null
]

Ref: user_refresh_tokens.id < user_refresh_tokens.replaced_by_token_id [
  delete: set null
]
