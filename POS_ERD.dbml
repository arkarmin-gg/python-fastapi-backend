// Grocery ERP MVP Database ERD
// Target database: PostgreSQL
// Strategy: custom-first ERP, SaaS-ready schema
// Core rule: Documents explain what happened. Ledgers prove what changed. Balances make it fast.

Project grocery_erp_mvp {
  database_type: "PostgreSQL"
  Note: '''
  Myanmar grocery retail/wholesale ERP MVP.

  Design decisions:
  - UUID primary keys.
  - tenant_id on all business-owned tables.
  - Product table represents stockable/sellable SKUs.
  - Unit conversion uses numeric decimal conversion_to_base.
  - Document lines store original quantity, unit, conversion_to_base, and quantity_base.
  - Stock is ledger-based through stock_movements.
  - stock_balances is a cached/rebuildable table.
  - FIFO sale costing is stored in sales_invoice_line_costs.
  - Repacking outputs create new stock_batches.
  - Customer and supplier ledgers are separate for MVP.
  '''
}

// =========================
// ENUMS
// =========================

Enum tenant_status {
  active
  suspended
  inactive
}

Enum user_status {
  active
  inactive
  locked
}

Enum unit_kind {
  weight
  count
  volume
  package
  length
  other
}

Enum catalog_item_kind {
  stocked
  service
  composite
}

Enum pos_tile_shape {
  square
  circle
  scallop
  hexagon
}

Enum location_type {
  warehouse
  store
  sub_warehouse
  counter
  damaged
  in_transit
  virtual
}

Enum assignment_role {
  responsible
  assistant
  checker
}

Enum document_status {
  draft
  pending_approval
  approved
  posted
  cancelled
  reversed
  rejected
}

Enum purchase_landed_cost_type {
  transport
  loading
  unloading
  customs
  tax
  other
}

Enum landed_cost_allocation_method {
  by_value
  by_base_quantity
  manual
}

Enum stock_batch_status {
  active
  depleted
  cancelled
}

Enum stock_movement_type {
  purchase_receive
  sale_issue
  transfer_out
  transfer_in
  repack_input
  repack_output
  adjustment
  count_adjustment
  damage_loss
  reversal
}

Enum source_type {
  purchase_invoice
  sales_invoice
  stock_transfer
  stock_adjustment
  stock_count
  repack_order
  customer_payment
  supplier_payment
  manual
}

Enum payment_method {
  cash
  bank
  mobile_money
  card
  other
}

Enum customer_ledger_entry_type {
  invoice
  payment
  adjustment
  reversal
}

Enum supplier_ledger_entry_type {
  purchase_invoice
  payment
  adjustment
  reversal
}

Enum party_status {
  active
  inactive
  blocked
}

Enum customer_type {
  walk_in
  retail
  wholesale
  restaurant
  hotel
  reseller
  other
}

Enum supplier_type {
  local
  importer
  wholesaler
  manufacturer
  other
}

Enum stock_adjustment_reason {
  count_variance
  damage
  loss
  expiry
  correction
  opening_balance
  other
}

// =========================
// FOUNDATION / TENANCY / AUTH
// =========================

Table tenants {
  id uuid [pk]
  name varchar(200) [not null]
  legal_name varchar(250)
  currency_code char(3) [not null, default: 'MMK']
  timezone varchar(80) [not null, default: 'Asia/Yangon']
  locale varchar(20) [not null, default: 'my-MM']
  status tenant_status [not null, default: 'active']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'One business/company. MVP exposes one tenant, but schema is SaaS-ready.'
}

Table employees {
  id uuid [pk]
  tenant_id uuid [not null, ref: > tenants.id]
  code varchar(50) [not null]
  name varchar(200) [not null]
  phone varchar(50)
  position varchar(120)
  joined_date date
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (tenant_id, code) [unique]
    (tenant_id, name)
  }
}

Table users {
  id uuid [pk]
  tenant_id uuid [not null, ref: > tenants.id]
  employee_id uuid [ref: > employees.id]
  name varchar(200) [not null]
  email varchar(255)
  phone varchar(50)
  password_hash text [not null]
  status user_status [not null, default: 'active']
  last_login_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (tenant_id, email) [unique]
    (tenant_id, phone)
    (tenant_id, employee_id)
  }
}

Table roles {
  id uuid [pk]
  tenant_id uuid [not null, ref: > tenants.id]
  code varchar(80) [not null]
  name varchar(120) [not null]
  description text
  is_system boolean [not null, default: false]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (tenant_id, code) [unique]
  }
}

Table permissions {
  id uuid [pk]
  code varchar(120) [not null, unique]
  name varchar(160) [not null]
  module varchar(80) [not null]
  description text

  Note: 'Global permission catalog. Example: sales.post, price.override, stock_adjustment.approve.'
}

Table role_permissions {
  id uuid [pk]
  tenant_id uuid [not null, ref: > tenants.id]
  role_id uuid [not null, ref: > roles.id]
  permission_id uuid [not null, ref: > permissions.id]

  indexes {
    (tenant_id, role_id, permission_id) [unique]
  }
}

Table user_roles {
  id uuid [pk]
  tenant_id uuid [not null, ref: > tenants.id]
  user_id uuid [not null, ref: > users.id]
  role_id uuid [not null, ref: > roles.id]

  indexes {
    (tenant_id, user_id, role_id) [unique]
  }
}

// =========================
// CATALOG / ITEMS / VARIANTS / UNITS
// =========================

Table units {
  id uuid [pk]
  code varchar(50) [not null, unique]
  name_en varchar(120) [not null]
  name_my varchar(120)
  unit_kind unit_kind [not null]
  is_global boolean [not null, default: true]
  is_active boolean [not null, default: true]

  Note: 'Global units such as viss, tical, bag, package, pack, piece, bottle, carton, kg, g.'
}

Table product_categories {
  id uuid [pk]
  tenant_id uuid [not null, ref: > tenants.id]
  parent_category_id uuid [ref: > product_categories.id]
  code varchar(50)
  name varchar(160) [not null]
  description text
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (tenant_id, code) [unique]
    (tenant_id, parent_category_id)
  }
}

Table catalog_items {
  id uuid [pk]
  tenant_id uuid [not null, ref: > tenants.id]
  name varchar(240) [not null]
  local_name varchar(240)
  description text
  category_id uuid [ref: > product_categories.id]
  item_kind catalog_item_kind [not null, default: 'stocked']
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (tenant_id, name)
    (tenant_id, category_id)
    (tenant_id, item_kind)
    (tenant_id, is_active)
  }

  Note: 'Item family/shared catalog identity. Product variants are the sellable, scannable, and stockable rows.'
}

Table product_variants {
  id uuid [pk]
  tenant_id uuid [not null, ref: > tenants.id]
  catalog_item_id uuid [not null, ref: > catalog_items.id]
  sku varchar(80) [not null]
  name varchar(160) [not null]
  local_name varchar(160)
  base_unit_id uuid [not null, ref: > units.id]
  default_sale_price numeric(20,4)
  default_purchase_cost numeric(20,4)
  track_inventory boolean [not null, default: true]
  track_batches boolean [not null, default: true]
  track_expiry boolean [not null, default: false]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (tenant_id, sku) [unique]
    (tenant_id, catalog_item_id)
    (tenant_id, base_unit_id)
    (tenant_id, is_active)
  }

  Note: 'Sellable/scannable catalog identity row. Inventory is keyed by product_variant_id in the variant base unit.'
}

Table variant_units {
  id uuid [pk]
  tenant_id uuid [not null, ref: > tenants.id]
  product_variant_id uuid [not null, ref: > product_variants.id]
  unit_id uuid [not null, ref: > units.id]
  is_base_unit boolean [not null, default: false]
  is_purchase_unit boolean [not null, default: false]
  is_sales_unit boolean [not null, default: false]
  conversion_to_base numeric(24,8) [not null]
  allow_decimal_quantity boolean [not null, default: true]
  rounding_precision numeric(24,8) [not null, default: 0.000001]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (tenant_id, product_variant_id, unit_id) [unique]
    (tenant_id, product_variant_id)
    (tenant_id, unit_id)
  }

  Note: 'Allowed sale/purchase unit conversion for one product variant. Exactly one active base row should match product_variants.base_unit_id with conversion_to_base = 1.'
}

Table variant_barcodes {
  id uuid [pk]
  tenant_id uuid [not null, ref: > tenants.id]
  product_variant_id uuid [not null, ref: > product_variants.id]
  variant_unit_id uuid [ref: > variant_units.id]
  barcode varchar(120) [not null]
  is_primary boolean [not null, default: false]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (tenant_id, product_variant_id)
    (tenant_id, barcode) [unique]
  }

  Note: 'Barcode aliases for scan lookup. A barcode may imply a specific variant unit.'
}

Table variant_pos_profiles {
  id uuid [pk]
  tenant_id uuid [not null, ref: > tenants.id]
  product_variant_id uuid [not null, ref: > product_variants.id]
  label varchar(80)
  color varchar(20)
  shape pos_tile_shape [not null, default: 'square']
  image_url varchar(500)
  sort_order int [not null, default: 0]
  is_visible boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (tenant_id, product_variant_id) [unique]
    (tenant_id, sort_order)
  }
}

Table variant_location_settings {
  id uuid [pk]
  tenant_id uuid [not null, ref: > tenants.id]
  product_variant_id uuid [not null, ref: > product_variants.id]
  location_id uuid [not null, ref: > locations.id]
  is_available boolean [not null, default: true]
  low_stock_quantity_base numeric(24,8)
  preferred_supplier_id uuid [ref: > suppliers.id]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (tenant_id, product_variant_id, location_id) [unique]
    (tenant_id, location_id)
  }
}

Table catalog_item_option_groups {
  id uuid [pk]
  tenant_id uuid [not null, ref: > tenants.id]
  catalog_item_id uuid [not null, ref: > catalog_items.id]
  name varchar(120) [not null]
  position int [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (tenant_id, catalog_item_id, name) [unique]
  }
}

Table catalog_item_option_values {
  id uuid [pk]
  tenant_id uuid [not null, ref: > tenants.id]
  option_group_id uuid [not null, ref: > catalog_item_option_groups.id]
  value varchar(120) [not null]
  position int [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (tenant_id, option_group_id, value) [unique]
  }
}

Table product_variant_option_values {
  id uuid [pk]
  tenant_id uuid [not null, ref: > tenants.id]
  product_variant_id uuid [not null, ref: > product_variants.id]
  option_value_id uuid [not null, ref: > catalog_item_option_values.id]

  indexes {
    (tenant_id, product_variant_id, option_value_id) [unique]
  }
}

// =========================
// CUSTOMERS / SUPPLIERS / PRICING
// =========================

Table price_levels {
  id uuid [pk]
  tenant_id uuid [not null, ref: > tenants.id]
  code varchar(80) [not null]
  name varchar(120) [not null]
  description text
  is_default boolean [not null, default: false]
  is_active boolean [not null, default: true]

  indexes {
    (tenant_id, code) [unique]
  }
}

Table customers {
  id uuid [pk]
  tenant_id uuid [not null, ref: > tenants.id]
  code varchar(80) [not null]
  name varchar(240) [not null]
  customer_type customer_type [not null, default: 'retail']
  price_level_id uuid [ref: > price_levels.id]
  phone varchar(50)
  address text
  credit_limit numeric(20,4)
  status party_status [not null, default: 'active']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (tenant_id, code) [unique]
    (tenant_id, name)
    (tenant_id, price_level_id)
  }
}

Table suppliers {
  id uuid [pk]
  tenant_id uuid [not null, ref: > tenants.id]
  code varchar(80) [not null]
  name varchar(240) [not null]
  supplier_type supplier_type [not null, default: 'local']
  phone varchar(50)
  address text
  status party_status [not null, default: 'active']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (tenant_id, code) [unique]
    (tenant_id, name)
  }
}

Table price_rules {
  id uuid [pk]
  tenant_id uuid [not null, ref: > tenants.id]
  product_variant_id uuid [not null, ref: > product_variants.id]
  variant_unit_id uuid [not null, ref: > variant_units.id]
  price_level_id uuid [not null, ref: > price_levels.id]
  customer_id uuid [ref: > customers.id]
  location_id uuid [ref: > locations.id]
  min_quantity numeric(24,8)
  currency_code char(3) [not null, default: 'MMK']
  unit_price numeric(20,4) [not null]
  effective_from timestamptz [not null]
  effective_to timestamptz
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (tenant_id, product_variant_id, variant_unit_id, price_level_id, effective_from)
    (tenant_id, product_variant_id)
    (tenant_id, customer_id)
    (tenant_id, location_id)
  }

  Note: 'Flexible price rules. Sales lines store final unit_price forever.'
}

// =========================
// LOCATIONS / RESPONSIBILITY
// =========================

Table locations {
  id uuid [pk]
  tenant_id uuid [not null, ref: > tenants.id]
  parent_location_id uuid [ref: > locations.id]
  code varchar(80) [not null]
  name varchar(180) [not null]
  location_type location_type [not null]
  is_sellable boolean [not null, default: false]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (tenant_id, code) [unique]
    (tenant_id, parent_location_id)
    (tenant_id, location_type)
  }
}

Table location_assignments {
  id uuid [pk]
  tenant_id uuid [not null, ref: > tenants.id]
  location_id uuid [not null, ref: > locations.id]
  employee_id uuid [not null, ref: > employees.id]
  role assignment_role [not null, default: 'responsible']
  start_date date [not null]
  end_date date
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (tenant_id, location_id, start_date)
    (tenant_id, employee_id, start_date)
  }

  Note: 'Historical assignment table for employee stock accountability.'
}

// =========================
// PURCHASES / RECEIVING / BATCHES
// =========================

Table purchase_invoices {
  id uuid [pk]
  tenant_id uuid [not null, ref: > tenants.id]
  document_no varchar(80) [not null]
  supplier_id uuid [not null, ref: > suppliers.id]
  receiving_location_id uuid [not null, ref: > locations.id]
  invoice_date date [not null]
  supplier_invoice_no varchar(120)
  status document_status [not null, default: 'draft']
  subtotal_amount numeric(20,4) [not null, default: 0]
  landed_cost_amount numeric(20,4) [not null, default: 0]
  total_amount numeric(20,4) [not null, default: 0]
  paid_amount numeric(20,4) [not null, default: 0]
  balance_amount numeric(20,4) [not null, default: 0]
  notes text
  posted_at timestamptz
  posted_by uuid [ref: > users.id]
  cancelled_at timestamptz
  cancelled_by uuid [ref: > users.id]
  reversal_of_id uuid [ref: > purchase_invoices.id]
  created_by uuid [ref: > users.id]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (tenant_id, document_no) [unique]
    (tenant_id, supplier_id, invoice_date)
    (tenant_id, receiving_location_id)
    (tenant_id, status)
  }
}

Table purchase_invoice_lines {
  id uuid [pk]
  tenant_id uuid [not null, ref: > tenants.id]
  purchase_invoice_id uuid [not null, ref: > purchase_invoices.id]
  line_no int [not null]
  product_variant_id uuid [not null, ref: > product_variants.id]
  variant_unit_id uuid [not null, ref: > variant_units.id]
  source_location_id uuid [ref: > locations.id]
  quantity numeric(24,8) [not null]
  conversion_to_base numeric(24,8) [not null]
  quantity_base numeric(24,8) [not null]
  unit_cost numeric(20,4) [not null]
  line_amount numeric(20,4) [not null]
  allocated_landed_cost numeric(20,4) [not null, default: 0]
  total_line_cost numeric(20,4) [not null, default: 0]
  unit_cost_base numeric(24,8) [not null]
  expiry_date date
  manufactured_date date
  lot_number varchar(120)
  created_stock_batch_id uuid [ref: > stock_batches.id]

  indexes {
    (tenant_id, purchase_invoice_id, line_no) [unique]
    (tenant_id, product_variant_id)
  }
}

Table purchase_landed_costs {
  id uuid [pk]
  tenant_id uuid [not null, ref: > tenants.id]
  purchase_invoice_id uuid [not null, ref: > purchase_invoices.id]
  cost_type purchase_landed_cost_type [not null]
  description text
  amount numeric(20,4) [not null]
  allocation_method landed_cost_allocation_method [not null, default: 'by_value']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (tenant_id, purchase_invoice_id)
  }
}

Table stock_batches {
  id uuid [pk]
  tenant_id uuid [not null, ref: > tenants.id]
  product_variant_id uuid [not null, ref: > product_variants.id]
  source_type source_type [not null]
  source_id uuid [not null]
  source_line_id uuid
  supplier_id uuid [ref: > suppliers.id]
  received_at timestamptz [not null]
  expiry_date date
  manufactured_date date
  lot_number varchar(120)
  initial_quantity_base numeric(24,8) [not null]
  unit_cost_base numeric(24,8) [not null]
  total_cost numeric(20,4) [not null]
  conversion_to_base numeric(24,8)
  status stock_batch_status [not null, default: 'active']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (tenant_id, product_variant_id, received_at)
    (tenant_id, product_variant_id, expiry_date)
    (tenant_id, supplier_id)
    (tenant_id, source_type, source_id)
  }

  Note: 'Batch source can be purchase_invoice, repack_order, or adjustment/opening balance.'
}

// =========================
// INVENTORY LEDGER / BALANCES
// =========================

Table stock_movements {
  id uuid [pk]
  tenant_id uuid [not null, ref: > tenants.id]
  movement_type stock_movement_type [not null]
  source_type source_type [not null]
  source_id uuid [not null]
  source_line_id uuid
  product_variant_id uuid [not null, ref: > product_variants.id]
  stock_batch_id uuid [not null, ref: > stock_batches.id]
  location_id uuid [not null, ref: > locations.id]
  quantity_base numeric(24,8) [not null]
  unit_cost_base numeric(24,8)
  total_cost numeric(20,4)
  notes text
  posted_at timestamptz [not null]
  posted_by uuid [not null, ref: > users.id]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (tenant_id, product_variant_id, location_id, posted_at)
    (tenant_id, stock_batch_id, posted_at)
    (tenant_id, source_type, source_id)
    (tenant_id, movement_type, posted_at)
  }

  Note: 'Immutable ledger. Positive quantity increases stock; negative quantity decreases stock.'
}

Table stock_balances {
  id uuid [pk]
  tenant_id uuid [not null, ref: > tenants.id]
  product_variant_id uuid [not null, ref: > product_variants.id]
  location_id uuid [not null, ref: > locations.id]
  stock_batch_id uuid [not null, ref: > stock_batches.id]
  quantity_base numeric(24,8) [not null, default: 0]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (tenant_id, product_variant_id, location_id, stock_batch_id) [unique]
    (tenant_id, product_variant_id, location_id)
    (tenant_id, stock_batch_id)
  }

  Note: 'Cached/rebuildable from stock_movements.'
}

// =========================
// SALES / FIFO COSTING
// =========================

Table sales_invoices {
  id uuid [pk]
  tenant_id uuid [not null, ref: > tenants.id]
  document_no varchar(80) [not null]
  customer_id uuid [ref: > customers.id]
  location_id uuid [not null, ref: > locations.id]
  price_level_id uuid [not null, ref: > price_levels.id]
  invoice_date date [not null]
  status document_status [not null, default: 'draft']
  subtotal_amount numeric(20,4) [not null, default: 0]
  discount_amount numeric(20,4) [not null, default: 0]
  total_amount numeric(20,4) [not null, default: 0]
  paid_amount numeric(20,4) [not null, default: 0]
  balance_amount numeric(20,4) [not null, default: 0]
  total_cost numeric(20,4) [not null, default: 0]
  gross_profit numeric(20,4) [not null, default: 0]
  notes text
  posted_at timestamptz
  posted_by uuid [ref: > users.id]
  cancelled_at timestamptz
  cancelled_by uuid [ref: > users.id]
  reversal_of_id uuid [ref: > sales_invoices.id]
  created_by uuid [ref: > users.id]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (tenant_id, document_no) [unique]
    (tenant_id, customer_id, invoice_date)
    (tenant_id, location_id, invoice_date)
    (tenant_id, status)
  }
}

Table sales_invoice_lines {
  id uuid [pk]
  tenant_id uuid [not null, ref: > tenants.id]
  sales_invoice_id uuid [not null, ref: > sales_invoices.id]
  line_no int [not null]
  product_variant_id uuid [not null, ref: > product_variants.id]
  variant_unit_id uuid [not null, ref: > variant_units.id]
  quantity numeric(24,8) [not null]
  conversion_to_base numeric(24,8) [not null]
  quantity_base numeric(24,8) [not null]
  unit_price numeric(20,4) [not null]
  discount_amount numeric(20,4) [not null, default: 0]
  line_total numeric(20,4) [not null]
  total_cost numeric(20,4) [not null, default: 0]
  gross_profit numeric(20,4) [not null, default: 0]
  price_rule_id uuid [ref: > price_rules.id]

  indexes {
    (tenant_id, sales_invoice_id, line_no) [unique]
    (tenant_id, product_variant_id)
    (tenant_id, source_location_id)
  }
}

Table sales_invoice_line_costs {
  id uuid [pk]
  tenant_id uuid [not null, ref: > tenants.id]
  sales_invoice_line_id uuid [not null, ref: > sales_invoice_lines.id]
  stock_batch_id uuid [not null, ref: > stock_batches.id]
  stock_movement_id uuid [not null, ref: > stock_movements.id]
  quantity_base numeric(24,8) [not null]
  unit_cost_base numeric(24,8) [not null]
  total_cost numeric(20,4) [not null]

  indexes {
    (tenant_id, sales_invoice_line_id)
    (tenant_id, stock_batch_id)
  }

  Note: 'FIFO proof table. One sale line can consume multiple batches.'
}

// =========================
// CUSTOMER PAYMENTS / RECEIVABLES
// =========================

Table customer_payments {
  id uuid [pk]
  tenant_id uuid [not null, ref: > tenants.id]
  document_no varchar(80) [not null]
  customer_id uuid [not null, ref: > customers.id]
  payment_date date [not null]
  payment_method payment_method [not null, default: 'cash']
  amount numeric(20,4) [not null]
  status document_status [not null, default: 'draft']
  notes text
  posted_at timestamptz
  posted_by uuid [ref: > users.id]
  cancelled_at timestamptz
  cancelled_by uuid [ref: > users.id]
  created_by uuid [ref: > users.id]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (tenant_id, document_no) [unique]
    (tenant_id, customer_id, payment_date)
  }
}

Table customer_payment_allocations {
  id uuid [pk]
  tenant_id uuid [not null, ref: > tenants.id]
  customer_payment_id uuid [not null, ref: > customer_payments.id]
  sales_invoice_id uuid [not null, ref: > sales_invoices.id]
  allocated_amount numeric(20,4) [not null]

  indexes {
    (tenant_id, customer_payment_id, sales_invoice_id) [unique]
    (tenant_id, sales_invoice_id)
  }
}

Table customer_ledger_entries {
  id uuid [pk]
  tenant_id uuid [not null, ref: > tenants.id]
  customer_id uuid [not null, ref: > customers.id]
  entry_type customer_ledger_entry_type [not null]
  debit_amount numeric(20,4) [not null, default: 0]
  credit_amount numeric(20,4) [not null, default: 0]
  balance_effect numeric(20,4) [not null]
  source_type source_type [not null]
  source_id uuid [not null]
  posted_at timestamptz [not null]
  posted_by uuid [not null, ref: > users.id]

  indexes {
    (tenant_id, customer_id, posted_at)
    (tenant_id, source_type, source_id)
  }
}

Table customer_balances {
  id uuid [pk]
  tenant_id uuid [not null, ref: > tenants.id]
  customer_id uuid [not null, ref: > customers.id]
  balance_amount numeric(20,4) [not null, default: 0]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (tenant_id, customer_id) [unique]
  }

  Note: 'Cached/rebuildable from customer_ledger_entries.'
}

// =========================
// SUPPLIER PAYMENTS / PAYABLES
// =========================

Table supplier_payments {
  id uuid [pk]
  tenant_id uuid [not null, ref: > tenants.id]
  document_no varchar(80) [not null]
  supplier_id uuid [not null, ref: > suppliers.id]
  payment_date date [not null]
  payment_method payment_method [not null, default: 'cash']
  amount numeric(20,4) [not null]
  status document_status [not null, default: 'draft']
  notes text
  posted_at timestamptz
  posted_by uuid [ref: > users.id]
  cancelled_at timestamptz
  cancelled_by uuid [ref: > users.id]
  created_by uuid [ref: > users.id]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (tenant_id, document_no) [unique]
    (tenant_id, supplier_id, payment_date)
  }
}

Table supplier_payment_allocations {
  id uuid [pk]
  tenant_id uuid [not null, ref: > tenants.id]
  supplier_payment_id uuid [not null, ref: > supplier_payments.id]
  purchase_invoice_id uuid [not null, ref: > purchase_invoices.id]
  allocated_amount numeric(20,4) [not null]

  indexes {
    (tenant_id, supplier_payment_id, purchase_invoice_id) [unique]
    (tenant_id, purchase_invoice_id)
  }
}

Table supplier_ledger_entries {
  id uuid [pk]
  tenant_id uuid [not null, ref: > tenants.id]
  supplier_id uuid [not null, ref: > suppliers.id]
  entry_type supplier_ledger_entry_type [not null]
  debit_amount numeric(20,4) [not null, default: 0]
  credit_amount numeric(20,4) [not null, default: 0]
  balance_effect numeric(20,4) [not null]
  source_type source_type [not null]
  source_id uuid [not null]
  posted_at timestamptz [not null]
  posted_by uuid [not null, ref: > users.id]

  indexes {
    (tenant_id, supplier_id, posted_at)
    (tenant_id, source_type, source_id)
  }
}

Table supplier_balances {
  id uuid [pk]
  tenant_id uuid [not null, ref: > tenants.id]
  supplier_id uuid [not null, ref: > suppliers.id]
  balance_amount numeric(20,4) [not null, default: 0]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (tenant_id, supplier_id) [unique]
  }

  Note: 'Cached/rebuildable from supplier_ledger_entries.'
}

// =========================
// STOCK TRANSFERS
// =========================

Table stock_transfers {
  id uuid [pk]
  tenant_id uuid [not null, ref: > tenants.id]
  document_no varchar(80) [not null]
  status document_status [not null, default: 'draft']
  requested_by uuid [ref: > users.id]
  posted_by uuid [ref: > users.id]
  posted_at timestamptz
  cancelled_by uuid [ref: > users.id]
  cancelled_at timestamptz
  reversal_of_id uuid [ref: > stock_transfers.id]
  notes text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (tenant_id, document_no) [unique]
    (tenant_id, status)
  }
}

Table stock_transfer_lines {
  id uuid [pk]
  tenant_id uuid [not null, ref: > tenants.id]
  stock_transfer_id uuid [not null, ref: > stock_transfers.id]
  line_no int [not null]
  product_variant_id uuid [not null, ref: > product_variants.id]
  variant_unit_id uuid [not null, ref: > variant_units.id]
  stock_batch_id uuid [not null, ref: > stock_batches.id]
  quantity numeric(24,8) [not null]
  conversion_to_base numeric(24,8) [not null]
  quantity_base numeric(24,8) [not null]
  from_location_id uuid [not null, ref: > locations.id]
  to_location_id uuid [not null, ref: > locations.id]

  indexes {
    (tenant_id, stock_transfer_id, line_no) [unique]
    (tenant_id, from_location_id)
    (tenant_id, to_location_id)
    (tenant_id, product_variant_id)
    (tenant_id, variant_unit_id)
  }

  Note: 'Posting creates transfer_out and transfer_in stock_movements.'
}

// =========================
// STOCK COUNTS / ADJUSTMENTS
// =========================

Table stock_counts {
  id uuid [pk]
  tenant_id uuid [not null, ref: > tenants.id]
  document_no varchar(80) [not null]
  location_id uuid [not null, ref: > locations.id]
  counted_at timestamptz [not null]
  counted_by uuid [not null, ref: > users.id]
  status document_status [not null, default: 'draft']
  approved_by uuid [ref: > users.id]
  approved_at timestamptz
  posted_by uuid [ref: > users.id]
  posted_at timestamptz
  notes text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (tenant_id, document_no) [unique]
    (tenant_id, location_id, counted_at)
  }

  Note: 'Timestamp-based count. Inventory does not need to freeze.'
}

Table stock_count_lines {
  id uuid [pk]
  tenant_id uuid [not null, ref: > tenants.id]
  stock_count_id uuid [not null, ref: > stock_counts.id]
  line_no int [not null]
  product_variant_id uuid [not null, ref: > product_variants.id]
  stock_batch_id uuid [ref: > stock_batches.id]
  expected_quantity_base numeric(24,8) [not null]
  counted_quantity_base numeric(24,8) [not null]
  variance_quantity_base numeric(24,8) [not null]
  adjustment_movement_id uuid [ref: > stock_movements.id]
  notes text

  indexes {
    (tenant_id, stock_count_id, line_no) [unique]
    (tenant_id, product_variant_id, stock_batch_id)
  }
}

Table stock_adjustments {
  id uuid [pk]
  tenant_id uuid [not null, ref: > tenants.id]
  document_no varchar(80) [not null]
  location_id uuid [not null, ref: > locations.id]
  reason stock_adjustment_reason [not null]
  status document_status [not null, default: 'draft']
  approved_by uuid [ref: > users.id]
  approved_at timestamptz
  posted_by uuid [ref: > users.id]
  posted_at timestamptz
  notes text
  created_by uuid [ref: > users.id]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (tenant_id, document_no) [unique]
    (tenant_id, location_id)
  }
}

Table stock_adjustment_lines {
  id uuid [pk]
  tenant_id uuid [not null, ref: > tenants.id]
  stock_adjustment_id uuid [not null, ref: > stock_adjustments.id]
  line_no int [not null]
  product_variant_id uuid [not null, ref: > product_variants.id]
  variant_unit_id uuid [not null, ref: > variant_units.id]
  stock_batch_id uuid [ref: > stock_batches.id]
  quantity numeric(24,8) [not null]
  conversion_to_base numeric(24,8) [not null]
  quantity_base numeric(24,8) [not null]
  unit_cost_base numeric(24,8)
  expiry_date date
  manufactured_date date
  lot_number varchar(120)
  notes text

  indexes {
    (tenant_id, stock_adjustment_id, line_no) [unique]
    (tenant_id, product_variant_id)
    (tenant_id, variant_unit_id)
    (tenant_id, stock_batch_id)
  }
}

// =========================
// REPACKING
// =========================

Table repack_orders {
  id uuid [pk]
  tenant_id uuid [not null, ref: > tenants.id]
  document_no varchar(80) [not null]
  location_id uuid [not null, ref: > locations.id]
  status document_status [not null, default: 'draft']
  performed_by uuid [ref: > employees.id]
  total_input_cost numeric(20,4) [not null, default: 0]
  total_output_cost numeric(20,4) [not null, default: 0]
  waste_cost numeric(20,4) [not null, default: 0]
  posted_by uuid [ref: > users.id]
  posted_at timestamptz
  cancelled_by uuid [ref: > users.id]
  cancelled_at timestamptz
  reversal_of_id uuid [ref: > repack_orders.id]
  notes text
  created_by uuid [ref: > users.id]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (tenant_id, document_no) [unique]
    (tenant_id, location_id)
    (tenant_id, performed_by)
  }
}

Table repack_order_inputs {
  id uuid [pk]
  tenant_id uuid [not null, ref: > tenants.id]
  repack_order_id uuid [not null, ref: > repack_orders.id]
  line_no int [not null]
  product_variant_id uuid [not null, ref: > product_variants.id]
  variant_unit_id uuid [not null, ref: > variant_units.id]
  stock_batch_id uuid [not null, ref: > stock_batches.id]
  quantity numeric(24,8) [not null]
  conversion_to_base numeric(24,8) [not null]
  quantity_base numeric(24,8) [not null]
  unit_cost_base numeric(24,8) [not null]
  total_cost numeric(20,4) [not null]

  indexes {
    (tenant_id, repack_order_id, line_no) [unique]
    (tenant_id, product_variant_id)
    (tenant_id, variant_unit_id)
    (tenant_id, stock_batch_id)
  }
}

Table repack_order_outputs {
  id uuid [pk]
  tenant_id uuid [not null, ref: > tenants.id]
  repack_order_id uuid [not null, ref: > repack_orders.id]
  line_no int [not null]
  product_variant_id uuid [not null, ref: > product_variants.id]
  variant_unit_id uuid [not null, ref: > variant_units.id]
  quantity numeric(24,8) [not null]
  conversion_to_base numeric(24,8) [not null]
  quantity_base numeric(24,8) [not null]
  allocated_cost numeric(20,4) [not null]
  unit_cost_base numeric(24,8) [not null]
  expiry_date date
  lot_number varchar(120)
  created_stock_batch_id uuid [ref: > stock_batches.id]

  indexes {
    (tenant_id, repack_order_id, line_no) [unique]
    (tenant_id, product_variant_id)
    (tenant_id, variant_unit_id)
    (tenant_id, created_stock_batch_id)
  }

  Note: 'Every posted output creates a new stock_batch.'
}

// =========================
// AUDIT
// =========================

Table audit_logs {
  id uuid [pk]
  tenant_id uuid [not null, ref: > tenants.id]
  actor_user_id uuid [ref: > users.id]
  action varchar(120) [not null]
  entity_type varchar(120) [not null]
  entity_id uuid [not null]
  before_json jsonb
  after_json jsonb
  reason text
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (tenant_id, entity_type, entity_id)
    (tenant_id, actor_user_id, created_at)
  }
}

// =========================
// IMPORTANT RELATION NOTES
// =========================

// Controlled polymorphic source fields:
// stock_movements.source_type/source_id/source_line_id
// customer_ledger_entries.source_type/source_id
// supplier_ledger_entries.source_type/source_id
// stock_batches.source_type/source_id/source_line_id
//
// Application services must validate these source references before posting.

// Suggested composite FK enforcement in PostgreSQL after implementation matures:
// Child tables can reference parent tables by (tenant_id, id) to prevent cross-tenant links.
