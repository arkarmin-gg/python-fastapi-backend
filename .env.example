# Copy to .env and adjust. python-fastapi-backend expects you to supply your own Postgres.

# local | staging | production. /docs and /redoc are hidden outside local/staging.
ENVIRONMENT=local

# Must use the asyncpg driver. Create the database first: createdb py_forge
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/py_forge

# Set true to log all SQL.
DB_ECHO=false

# Comma-separated list, or "*" for all (dev only). Cannot be "*" when ENVIRONMENT=production.
CORS_ORIGINS=*

# --- Auth domain (AUTH_ prefix) ---
# Generate a strong secret, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_JWT_SECRET=
AUTH_JWT_ALG=HS256
AUTH_JWT_ACCESS_EXP_MINUTES=15
AUTH_REFRESH_TOKEN_EXP_DAYS=14

# --- Seed script (scripts/seed.py) ---
ORGANIZATION_CODE=demo
ORGANIZATION_NAME=Demo Organization
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=ChangeMe123!
# Aliases: USER_EMAIL, USER_PASSWORD, USER_NAME, USER_PHONE (see README)
